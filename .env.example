# Brand displayed to customers and sent to Stripe as the line-item name.
# Keep under ~80 chars; MintOffice trims to 250 before passing on.
PARTNER_BRAND=AcmeAI

# MintOffice API base — DEV by default. LIVE is https://mint.mintbot.ai
MINTOFFICE_API_URL=https://mint.mintbot.dev

# Partner API key. Format: mo_live_… (issued by mintbot ops via CatOffice).
MINTOFFICE_API_KEY=mo_live_REPLACE_ME

# Webhook secret for verifying X-Mintbot-Signature on inbound events.
# Optional — only required if you've set a Webhook URL on your partner row.
# Leave blank while you're getting the portal up; orders and admin still work
# without it (the receiver will 401 every event until the secret is set).
MINTOFFICE_WEBHOOK_SECRET=

# Public base URL this portal is reachable on (must be HTTPS for MintOffice
# to send webhooks — the SSRF guard rejects private IPs). The success_url
# / cancel_url passed to MintOffice are built off this.
PUBLIC_BASE_URL=https://acmeai.example.com

# HTTP Basic Auth credentials for /admin. Use a long random password in
# production deployments — this is the only gate on the event browser.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Path to the SQLite file.
# - Bare-metal: defaults to ./portal.db in the working directory.
# - Docker: the Dockerfile sets DB_PATH=/data/portal.db and the compose
#   file mounts a named volume at /data so events survive restarts.
# Override below only if you want a custom location.
DB_PATH=./portal.db
